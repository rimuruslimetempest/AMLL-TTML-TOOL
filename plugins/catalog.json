{
  "plugins": [
    {
      "id": "whitespace-cleaner",
      "name": "Whitespace Cleaner",
      "author": "Rimurulover",
      "version": "1.0.0",
      "description": "Collapses repeated whitespace and removes zero-width characters from lyric text. Timing and word order stay untouched.",
      "type": "tool",
      "apiVersion": 2,
      "permissions": ["lyrics:read", "lyrics:write", "ui:toolbar"],
      "slots": ["toolbar"],
      "tags": ["text", "cleanup", "toolbar"],
      "minAppVersion": "2.1.0",
      "addedAt": "2026-11-26",
      "homepage": "https://github.com/rimuruslimetempest/AMLL-TTML-TOOL",
      "verified": true,
      "lib": "whitespace_cleaner"
    },
    {
      "id": "entity-decoder",
      "name": "HTML Entity Decoder",
      "author": "Rimurulover",
      "version": "1.0.0",
      "description": "Decodes HTML entities such as &amp; and &#39; in imported lyric text. Timing and word order stay untouched.",
      "type": "tool",
      "apiVersion": 2,
      "permissions": ["lyrics:read", "lyrics:write", "ui:toolbar"],
      "slots": ["toolbar"],
      "tags": ["text", "import", "toolbar"],
      "minAppVersion": "2.1.0",
      "addedAt": "2026-11-26",
      "homepage": "https://github.com/rimuruslimetempest/AMLL-TTML-TOOL",
      "verified": true,
      "lib": "entity_decoder"
    }
  ]
}
