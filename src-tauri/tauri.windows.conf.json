{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"app": {
		"windows": [
			{
				"title": "TTML Tool",
				"label": "main",
				"width": 1280,
				"height": 800,
				"minWidth": 960,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"transparent": true,
				"visible": false,
				"decorations": false,
				"center": true,
				"devtools": true,
				"dragDropEnabled": false,
				"browserExtensionsEnabled": true,
				"windowEffects": {
					"effects": ["tabbed", "mica"]
				}
			}
		],
		"security": {
			"headers": {
				"Cross-Origin-Opener-Policy": "same-origin",
				"Cross-Origin-Embedder-Policy": "credentialless"
			}
		}
	},
	"bundle": {
		"targets": ["nsis", "msi"],
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"installerIcon": "icons/icon.ico"
			}
		}
	}
}
