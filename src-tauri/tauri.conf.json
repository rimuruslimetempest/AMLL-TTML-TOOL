{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "TTML Editor",
	"version": "5.1.0",
	"identifier": "com.bobjoerules.amll-ttml-tool",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build && npm run build:collab-web"
	},
	"app": {
		"windows": [
			{
				"title": "",
				"label": "main",
				"width": 1280,
				"height": 800,
				"resizable": true,
				"devtools": true,
				"fullscreen": false,
				"dragDropEnabled": false,
				"visible": false,
				"theme": "Dark",
				"minWidth": 960,
				"minHeight": 600
			}
		],
		"security": {
			"csp": null,
			"headers": {
				"Cross-Origin-Opener-Policy": "same-origin",
				"Cross-Origin-Embedder-Policy": "require-corp"
			},
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [
			"resources/web/**/*"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MTVGNjc5N0I4MDQzMzUKUldRMVE0QjdlZllWZUdqakZ5ZG9TMDEwWUhUUXUzYjR1R3Y0aXBMeng2bHVTUzE1eDhhYVI5NHoK",
			"endpoints": [
				"https://github.com/rimuruslimetempest/AMLL-TTML-TOOL/releases/latest/download/latest.json"
			]
		}
	}
}
