{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "TTML Tool",
	"version": "2.0.0",
	"identifier": "com.rimuruslimetempest.ttmltool",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build && pnpm build:collab-web"
	},
	"app": {
		"windows": [
			{
				"title": "TTML Tool",
				"label": "main",
				"create": false,
				"width": 1280,
				"height": 800,
				"resizable": true,
				"devtools": true,
				"fullscreen": false,
				"dragDropEnabled": false,
				"visible": false,
				"theme": "Dark",
				"minWidth": 960,
				"minHeight": 600
			}
		],
		"security": {
			"csp": null,
			"headers": {
				"Cross-Origin-Opener-Policy": "same-origin",
				"Cross-Origin-Embedder-Policy": "require-corp"
			},
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"publisher": "Rimurulover",
		"copyright": "Copyright © 2026 Rimurulover",
		"homepage": "https://github.com/rimuruslimetempest/AMLL-TTML-TOOL",
		"category": "Music",
		"shortDescription": "A word-synced TTML lyric editor for Apple Music-style lyrics.",
		"longDescription": "TTML Tool is a desktop editor for word-synced TTML lyrics, with manual timing, a smooth live preview, format import and export, live rooms, comments, and collaboration.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [
			"resources/web/**/*",
			"downloader-tools/"
		],
		"fileAssociations": [
			{
				"ext": ["ttml"],
				"name": "TTML Lyric",
				"description": "TTML timed lyric file",
				"role": "Editor"
			},
			{
				"ext": ["lrc"],
				"name": "LRC Lyric",
				"description": "LRC timed lyric file",
				"role": "Editor"
			},
			{
				"ext": ["srt"],
				"name": "SRT Subtitle",
				"description": "SRT subtitle file",
				"role": "Editor"
			}
		],
		"createUpdaterArtifacts": true,
		"macOS": {
			"signingIdentity": "-"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MTVGNjc5N0I4MDQzMzUKUldRMVE0QjdlZllWZUdqakZ5ZG9TMDEwWUhUUXUzYjR1R3Y0aXBMeng2bHVTUzE1eDhhYVI5NHoK",
			"endpoints": [
				"https://github.com/rimuruslimetempest/AMLL-TTML-TOOL/releases/latest/download/latest.json"
			]
		}
	}
}
