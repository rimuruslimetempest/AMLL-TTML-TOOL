pkgname=ttml-tool-git
pkgver=1.0.0
pkgrel=1
pkgdesc="A word-synced TTML lyric editor for Apple Music-style lyrics"
arch=('x86_64')
options=(!lto)
url="https://github.com/rimuruslimetempest/AMLL-TTML-TOOL"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'gst-plugins-ugly' 'cairo' 'pango' 'gdk-pixbuf2' 'glib2' 'gtk3' 'libappindicator')
makedepends=('cargo' 'nodejs' 'pnpm' 'git')
provides=("ttml-tool")
conflicts=("ttml-tool")
source=("git+https://github.com/rimuruslimetempest/AMLL-TTML-TOOL.git"
        "ttml-tool.desktop")
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd ttml-tool
  git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g' | sed 's/^v//'
}

prepare() {
  cd ttml-tool
  pnpm install --frozen-lockfile
}

build() {
  cd ttml-tool
  pnpm tauri build --no-bundle
}

package() {
  cd ttml-tool

  install -Dm755 "src-tauri/target/release/ttml-tool" "$pkgdir/usr/bin/ttml-tool"

  install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/ttml-tool.png"
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/ttml-tool.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/ttml-tool.png"

  install -Dm644 "$srcdir/ttml-tool.desktop" "$pkgdir/usr/share/applications/ttml-tool.desktop"
}
