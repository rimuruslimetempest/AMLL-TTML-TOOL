# TTML Tool environment variables
# Copy this file to .env and fill in only the values you need.
# .env is gitignored; never commit real credentials.

# Optional: a Sentry DSN for opt-in crash reports.
SENTRY_DSN=

# Optional: an HTTP endpoint that receives opt-in crash reports.
VITE_CRASH_REPORT_URL=

# Optional: override the packaged app version used in diagnostics.
VITE_APP_VERSION=

# Optional: use your own Firebase project for cloud features.
# The app falls back to the upstream Firebase project when these are empty.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Crowdin personal token for `pnpm locale:pull` / `pnpm locale:push`.
CROWDIN_PERSONAL_TOKEN=

# Optional: CORS proxy prefixes used by the browser build for Apple Music TTML
# and SpotMatch lookups. Desktop builds use the native Rust fetch path.
VITE_APPLE_TTML_PROXY=
VITE_SPOTMATCH_PROXY=